#!/usr/bin/env bash
set -e

# 1. Branch Protection Guard for 'main'
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

if [ "$CURRENT_BRANCH" = "main" ] && [ "$ALLOW_MAIN_COMMIT" != "1" ]; then
    echo "======================================================"
    echo " ⛔ DIRECT COMMIT TO 'main' RESTRICTED"
    echo "======================================================"
    echo " Direct commits to 'main' are blocked to prevent"
    echo " accidental breakage and premature version bumps."
    echo ""
    echo " Please create a feature branch and submit via PR:"
    echo "   git checkout -b feat/your-feature-name"
    echo "   git commit -m 'feat: description of changes'"
    echo ""
    echo " (To bypass in emergency: ALLOW_MAIN_COMMIT=1 git commit)"
    echo "======================================================"
    exit 1
fi

# 2. Run Verification Checks
echo "======================================================"
echo " Running pre-commit verification checks on '$CURRENT_BRANCH'..."
echo "======================================================"

# Determine Python environment
if [ -f ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"
else
    PYTHON="python3"
fi

# Run the verification engine
$PYTHON scripts/verify.py

if [ $? -ne 0 ]; then
    echo "======================================================"
    echo " ✖ Pre-commit verification failed! Commit aborted."
    echo " Fix the issues above or use 'git commit --no-verify' if emergency."
    echo "======================================================"
    exit 1
fi
